---
// src/pages/index.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { SearchGames } from '../components/SearchGames';
---

<Layout title="La Yapa Gamer | Comparador de Precios y Ofertas de Videojuegos">
  <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    
    <!-- Hero Header -->
    <section class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-xs font-semibold px-3 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Comparador de precios en tiempo real
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight">
        Encuentra tu juego al <br />
        <span class="text-emerald-400">precio más bajo</span>
      </h1>

      <p class="text-zinc-400 text-xs sm:text-base max-w-xl mx-auto leading-relaxed">
        Compara todas las ediciones oficiales en Soles peruanos y Dólares antes de comprar.
      </p>
    </section>

    <!-- Buscador React (Se ejecuta 100% en el cliente) -->
    <section class="w-full">
      <SearchGames client:only="react" />
    </section>

  </main>
</Layout>